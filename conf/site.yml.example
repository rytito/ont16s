# Copia a conf/site.yml y edita. NO se versiona: las rutas absolutas y el
# nombre de cuenta son específicos de un clúster.
#
#   cp conf/site.yml.example conf/site.yml

account:       lp_myproject

# Instalación estática de Dorado y modelos pre-descargados.
# Colócalos en almacenamiento del GRUPO. Un directorio personal (home o data)
# significa que el pipeline se rompe para todos cuando una cuenta cambia.
dorado_bin:    /shared/software/dorado-2.1.0-linux-x64/bin
dorado_models: /shared/software/dorado_models

# Entornos conda -- ver docs/USAGE.md para cómo construirlos.
conda_ont:     /shared/conda_envs/ont
conda_emu:     /shared/conda_envs/emu
conda_r:       /shared/conda_envs/r        # opcional; recurre a conda_ont

# Bases de datos de Emu: nombre:ruta[,nombre:ruta]
#
# GTDB sola es el valor por defecto sensato. Añade SILVA solo cuando
# necesites el chequeo de cloroplastos/mitocondrias -- necesita ~48 GB de RAM
# por tarea y aproximadamente triplica el tiempo de ejecución.
emu_dbs:       'gtdb:/shared/databases/emu_gtdb_r226'

kit:           SQK-16S114-24
